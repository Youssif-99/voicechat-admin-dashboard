# Next.js Admin Dashboard — Environment Configuration

# Express backend (source of truth)
EXPRESS_API_URL=http://localhost:3000

# Realtime Socket.IO
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000
NEXT_PUBLIC_EXPRESS_URL=http://localhost:3000

# Must match INTERNAL_SERVICE_TOKEN in Express backend .eضnv
INTERNAL_SERVICE_TOKEN=int-svc-token-voice-admin-2026-change-in-prod

# Session cookie signing
# Session cookie signing secret — MUST be changed before production deployment.
# Minimum 32 characters. Used to sign the admin_session HttpOnly cookie.
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=d3v-s3cr3t-v0ice-adm1n-2026-ch4nge-b3f0re-pr0d-d3pl0yment

# Icon catalog database (the ONLY Prisma DB the dashboard uses)
#
# DATABASE_URL  → pooler URL (-pooler in hostname) used by Prisma Client at runtime.
#   connect_timeout=15 gives Neon's auto-suspended compute up to 15 s to wake before
#   Prisma gives up. The default is 5 s — not enough for a cold start.
#
# DIRECT_URL    → non-pooler URL (no -pooler) used by Prisma CLI only
#   (prisma migrate dev / prisma db push). PgBouncer does not support the
#   prepared-statement protocol that Prisma Migrate requires.
DATABASE_URL="postgresql://neondb_owner:npg_i3rnohlUeHY7@ep-steep-sky-b4hv2ocm-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require&connect_timeout=15"
DIRECT_URL="postgresql://neondb_owner:npg_i3rnohlUeHY7@ep-steep-sky-b4hv2ocm.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require&connect_timeout=15"

# Public URL (used by storage.ts to generate icon URLs)
# Must match the port where Next.js Dashboard runs (configured in package.json: -p 3001)
NEXT_PUBLIC_BASE_URL=http://localhost:3001

# Test credentials (for integration tests)
TEST_ADMIN_EMAIL=youssifdeveloperr999@gmail.com
TEST_ADMIN_PASSWORD=youssif999

NODE_ENV=development
