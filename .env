# ─────────────────────────────────────────────────────────────────────────────
# Next.js Admin Dashboard — Environment Configuration
#
# The dashboard NEVER connects to PostgreSQL for business logic.
# All data is fetched from the Express backend via REST API.
# The only local DB use is the Icon catalog (separate Neon DB).
# ─────────────────────────────────────────────────────────────────────────────

# Express backend (source of truth)
EXPRESS_API_URL=http://localhost:3000

# Realtime Socket.IO
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000
NEXT_PUBLIC_EXPRESS_URL=http://localhost:3000

# Must match INTERNAL_SERVICE_TOKEN in Express backend .env
INTERNAL_SERVICE_TOKEN=int-svc-token-voice-admin-2026-change-in-prod

# Session cookie signing
SESSION_SECRET=change-this-to-a-long-random-string-in-production

# Icon catalog database (the ONLY Prisma DB the dashboard uses)
DATABASE_URL="postgresql://neondb_owner:npg_ZmIqvtjA05xY@ep-lucky-boat-at2wmga1-pooler.c-9.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Public URL (used in integration tests)
NEXT_PUBLIC_BASE_URL=http://localhost:3001

# Test credentials (for integration tests)
TEST_ADMIN_EMAIL=admin@voicechatapp.com
TEST_ADMIN_PASSWORD=Admin@123456

NODE_ENV=development
