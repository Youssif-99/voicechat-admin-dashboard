# ──────────────────────────────────────────────────────────────────────────────
# Next.js Admin Dashboard — Environment Example
# Copy this file to .env and fill in every value before running.
# DO NOT commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── Express Backend (THE source of truth) ────────────────────────────────────
# All admin API calls go here. NEVER bypass this with direct DB access.
EXPRESS_API_URL=http://localhost:4000

# ── Realtime Socket.IO ────────────────────────────────────────────────────────
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
NEXT_PUBLIC_EXPRESS_URL=http://localhost:4000

# ── Dashboard session cookie signing ─────────────────────────────────────────
# Generate: openssl rand -hex 32
SESSION_SECRET=change-this-to-a-long-random-string-in-production

# ── Internal Service Token ────────────────────────────────────────────────────
# Must match INTERNAL_SERVICE_TOKEN in Express backend .env
# Used for server-to-server event relay
INTERNAL_SERVICE_TOKEN=change-this-to-match-express-backend

# ── Icon Catalog Database (local — icon management ONLY) ─────────────────────
# The ONLY database the dashboard touches directly.
# All user/room/agency/payment data comes from Express API.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/neondb?sslmode=require&channel_binding=require
DIRECT_URL=postgresql://USER:PASSWORD@YOUR-NEON-DIRECT-HOST/neondb?sslmode=require&channel_binding=require

# ── Public base URL ───────────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ── Test credentials (integration tests only) ─────────────────────────────────
# TEST_ADMIN_EMAIL=admin@example.com
# TEST_ADMIN_PASSWORD=admin123
