model AppAsset {
  id                String               @id @default(cuid())
  key               String               @unique
  name              String
  category          String
  imageUrl          String?
  thumbnailUrl      String?
  mimeType          String?
  hash              String?
  sizeBytes         Int?
  width             Int?
  height            Int?
  version           Int                  @default(1)
  isActive          Boolean              @default(true)
  deletedAt         DateTime?
  updatedBy         String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  versions          AppAssetVersion[]
  auditLogs         AppAssetAuditLog[]

  @@index([category])
  @@index([deletedAt])
}

model AppAssetVersion {
  id            String    @id @default(cuid())
  assetId       String
  version       Int
  imageUrl      String?
  thumbnailUrl  String?
  mimeType      String?
  hash          String?
  sizeBytes     Int?
  updatedBy     String?
  updatedByName String?
  changeNote    String?
  createdAt     DateTime  @default(now())
  asset         AppAsset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([version])
}

model AppAssetAuditLog {
  id         String    @id @default(cuid())
  assetId    String?
  action     String
  adminId    String
  adminName  String
  adminEmail String
  ipAddress  String?
  userAgent  String?
  metadata   String?
  createdAt  DateTime  @default(now())
  asset      AppAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([assetId])
  @@index([action])
  @@index([adminId])
}

model AppAssetCatalogVersion {
  id        String   @id
  version   Int      @default(1)
  etag      String
  updatedAt DateTime @updatedAt
}

